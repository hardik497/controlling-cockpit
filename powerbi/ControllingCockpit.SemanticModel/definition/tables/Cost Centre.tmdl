			column: 'Cost Centre'

	partition 'Cost Centre' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "dim_cost_centre.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					// empty CSV fields -> null, so typed conversion does not raise errors
					Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, (v) => if v = "" then null else v})),
					// en-US culture: decimal point is '.', independent of the Windows locale
					Typed = Table.TransformColumnTypes(Nulls, {
						{"cost_centre_key", Int64.Type},
						{"cost_centre_code", type text},
						{"cost_centre_name", type text},
						{"cost_centre_label", type text},
						{"department", type text},
						{"region", type text},
						{"manager", type text}
					}, "en-US"),
					Renamed = Table.RenameColumns(Typed, {
						{"cost_centre_key", "Cost Centre Key"},
						{"cost_centre_code", "Cost Centre Code"},
						{"cost_centre_name", "Cost Centre Name"},
						{"cost_centre_label", "Cost Centre"},
						{"department", "Department"},
						{"region", "Region"},
						{"manager", "Manager"}
					})
				in
					Renamed

	annotation PBI_ResultType = Table
