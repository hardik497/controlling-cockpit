	partition 'Rejected Rows' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "fact_finance_rejected.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
					// empty CSV fields -> null, so typed conversion does not raise errors
					Nulls = Table.TransformColumns(Promoted, List.Transform(Table.ColumnNames(Promoted), each {_, (v) => if v = "" then null else v})),
					// en-US culture: decimal point is '.', independent of the Windows locale
					Typed = Table.TransformColumnTypes(Nulls, {
						{"scenario", type text},
						{"source_table", type text},
						{"record_key", type text},
						{"document_ref", type text},
						{"posting_date", type datetime},
						{"period", type text},
						{"account_code", type text},
						{"cost_centre_code", type text},
						{"amount", Currency.Type},
						{"reject_check_id", type text},
						{"reject_reason", type text},
						{"all_check_ids", type text},
						{"rejected_at", type datetime}
					}, "en-US"),
					Renamed = Table.RenameColumns(Typed, {
						{"scenario", "Scenario"},
						{"source_table", "Source Table"},
						{"record_key", "Record Key"},
						{"document_ref", "Document Ref"},
						{"posting_date", "Posting Date"},
						{"period", "Period"},
						{"account_code", "Account Code"},
						{"cost_centre_code", "Cost Centre Code"},
						{"amount", "Amount"},
						{"reject_check_id", "Check ID"},
						{"reject_reason", "Reject Reason"},
						{"all_check_ids", "All Check IDs"},
						{"rejected_at", "Rejected At"}
					})
				in
					Renamed

	annotation PBI_ResultType = Table
